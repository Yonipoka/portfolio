{
  "name": "john-nucum-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Personal portfolio of John Stewart Nucum — junior business analyst, Geneva.",
  "scripts": {
    "dev": "npm run gen:html && vite",
    "gen:html": "node scripts/gen-html.mjs",
    "gen:images": "node scripts/gen-images.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run gen:html && tsc --noEmit && vite build",
    "preview": "vite preview",
    "check:links": "node scripts/check-links.mjs",
    "audit": "node scripts/audit.mjs",
    "preflight": "node scripts/preflight.mjs",
    "qa": "node scripts/qa.mjs",
    "verify": "npm run build && npm run check:links"
  },
  "dependencies": {
    "@react-spring/web": "^10.1.2",
    "animejs": "^4.5.0",
    "gsap": "^3.15.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "^1.63.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
